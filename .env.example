# Copy to .env.local and fill in.
#
# Local development: run `supabase start` and take the values from
# `supabase status`. The Project URL is http://127.0.0.1:54321.
#
# Hosted: Supabase dashboard -> Project Settings -> API.

# Safe to expose. Ships to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NEVER expose. No NEXT_PUBLIC_ prefix, so it stays server-only.
# This key bypasses Row Level Security — it can read every student's email
# address and resume. Server actions only.
SUPABASE_SERVICE_ROLE_KEY=

# Instagram — optional. Without these the homepage grid falls back to
# placeholder tiles that link through to the profile.
#
# Requires: a Professional (Business or Creator) Instagram account, a Meta app
# with the Instagram API product added, and a long-lived access token.
# See the README for the steps. Server-only — no NEXT_PUBLIC_ prefix.
INSTAGRAM_ACCESS_TOKEN=
# Optional. Defaults to "me", which is right for a token issued to the account.
INSTAGRAM_USER_ID=

# Only needed to mint or refresh an Instagram token with `npm run ig:token`.
# Meta App Dashboard -> App settings -> Basic -> App secret.
# NEVER give this a NEXT_PUBLIC_ prefix and never send it to a browser.
INSTAGRAM_APP_SECRET=
